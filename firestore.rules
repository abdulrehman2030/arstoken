rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return signedIn() && userDoc().status == "approved";
    }

    function trialValid() {
      return userDoc().planStatus == "trial" &&
        userDoc().trialEndAt is timestamp &&
        request.time <= userDoc().trialEndAt;
    }

    function activeValid() {
      return userDoc().planStatus == "active" &&
        userDoc().subscriptionEndAt is timestamp &&
        request.time <= userDoc().subscriptionEndAt;
    }

    function hasLivePlan() {
      return trialValid() || activeValid();
    }

    function hasAccess() {
      return isApproved() && hasLivePlan();
    }

    // User doc: self read, restricted self writes (no plan/status control from client).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          "phone", "createdAt", "updatedAt", "lastSeenAt", "fcmToken"
        ]);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "phone", "createdAt", "updatedAt", "lastSeenAt", "fcmToken"
        ]);
      allow delete: if false;

      match /profile/{docId} {
        allow read, write: if isOwner(userId) && hasAccess();
      }

      match /customers/{docId} {
        allow read, write: if isOwner(userId) && hasAccess();
      }

      match /items/{docId} {
        allow read, write: if isOwner(userId) && hasAccess();
      }

      match /categories/{docId} {
        allow read, write: if isOwner(userId) && hasAccess();
      }

      match /sales/{docId} {
        allow read, write: if isOwner(userId) && hasAccess();
      }

      match /sale_items/{docId} {
        allow read, write: if isOwner(userId) && hasAccess();
      }

      match /credit_ledger/{docId} {
        allow read, write: if isOwner(userId) && hasAccess();
      }

      match /store_settings/{docId} {
        allow read, write: if isOwner(userId) && hasAccess();
      }

      // Default safeguard for new subcollections.
      match /{document=**} {
        allow read, write: if isOwner(userId) && hasAccess();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
